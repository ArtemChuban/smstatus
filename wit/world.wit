package smstatus:module;

interface host {
  read-sysfs: func(path: string) -> result<string, string>;
  record time-state {
    now-ms: u64,
    offset-seconds: s32,
  }
  read-time-state: func() -> time-state;
  record xkb-state {
    active-group: u8,
    symbols: string,
  }
  read-xkb-state: func() -> result<xkb-state, string>;
}

interface guest {
  record output {
    text: string,
    interval-ms: u32,
  }
  init: func(config: string);
  update: func() -> output;
  on-click: func(button: u8);
}

world module {
  import host;
  export guest;
}
