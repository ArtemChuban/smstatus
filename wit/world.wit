package smstatus:module;

interface host {
  read-sysfs: func(path: string) -> result<string, string>;
  record time-state {
    now-ms: u64,
    offset-seconds: s32,
  }
  read-time-state: func() -> time-state;
  record xkb-state {
    active-group: u8,
    symbols: string,
  }
  read-xkb-state: func() -> result<xkb-state, string>;
  record disk-usage {
    total-bytes: u64,
    used-bytes: u64,
    free-bytes: u64,
  }
  read-disk-usage: func(device: string) -> result<disk-usage, string>;
  record mem-usage {
    total-bytes: u64,
    used-bytes: u64,
    free-bytes: u64,
  }
  read-mem-usage: func() -> result<mem-usage, string>;
  read-process-running: func(name: string) -> result<bool, string>;
  http-get: func(url: string, headers: list<tuple<string, string>>) -> result<string, string>;
  call-host-module: func(module: string, method: string, payload: string) -> result<string, string>;
}

interface guest {
  record output {
    text: string,
    interval-ms: u32,
  }

  record host-api-version {
    major: u32,
    minor: u32,
    patch: u32,
  }

  init: func(config: string);
  update: func() -> output;

  required-host-api-version: func() -> host-api-version;

  required-host-modules: func() -> list<string>;

  record metadata {
    display-name: string,
    version: string,
    author: string,
  }

  get-metadata: func() -> metadata;

  record config-param {
    name: string,
    param-type: string,
    default: string,
  }

  config-schema: func() -> list<config-param>;
}

world module {
  import host;
  export guest;
}
