package smstatus:module;

interface host {
  now-ms: func() -> u64;
  read-sysfs: func(path: string) -> result<string, string>;
  local-offset-seconds: func() -> s32;
  record xkb-state {
    active-group: u8,
    symbols: string,
  }
  read-xkb-state: func() -> result<xkb-state, string>;
}

interface guest {
  record output {
    text: string,
    interval-ms: u32,
  }
  init: func(config: string);
  update: func() -> output;
  on-click: func(button: u8);
}

world module {
  import host;
  export guest;
}
