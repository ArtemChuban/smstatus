package smstatus:module;

interface host {
  call-extension: func(extension: string, method: string, payload: string) -> result<string, string>;

  record extension-event {
    extension: string,
    event: string,
    payload: string,
  }

  subscribe-extension-event: func(extension: string, event: string) -> result<_, string>;
  take-extension-event: func() -> option<extension-event>;
}

interface guest {
  record output {
    text: string,
    interval-ms: u32,
  }

  init: func(config: string);
  update: func() -> output;

  record config-param {
    name: string,
    param-type: string,
    default: string,
  }

  config-schema: func() -> list<config-param>;
}

world module {
  import host;
  export guest;
}
