package bslstatus:module;

interface host {
  now-ms: func() -> u64;
  read-sysfs: func(path: string) -> result<string, string>;
}

interface guest {
  record output {
    text: string,
    interval-ms: u32,
  }
  init: func(config: string);
  update: func() -> output;
  on-click: func(button: u8);
}

world module {
  import host;
  export guest;
}
